{
  "name": "compass",
  "productName": "Compass",
  "version": "1.0.3",
  "description": "Launchpad lightshow playground.",
  "main": ".vite/build/main.js",
  "private": true,
  "packageManager": "npm@11.5.1",
  "engines": {
    "node": "24.13.1"
  },
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "web:dev": "vite --config vite.renderer.config.mts --host 127.0.0.1 --port 4173",
    "web:build": "vite build --config vite.renderer.config.mts",
    "rack:frames": "tsx scripts/render-rack-frames.ts",
    "lint": "eslint .",
    "check": "tsx scripts/check.ts",
    "postinstall": "patch-package"
  },
  "author": {
    "name": "Si Hyun Baek",
    "email": "62822977+sihyunlts@users.noreply.github.com"
  },
  "license": "0BSD",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-fuses": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@electron/fuses": "^1.8.0",
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@types/node": "24.13.1",
    "electron": "43.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.8.0",
    "patch-package": "^8.0.1",
    "sass": "^1.102.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "material-symbols": "^0.45.10",
    "pretendard-jp": "^1.3.9"
  },
  "optionalDependencies": {
    "appdmg": "^0.6.6"
  }
